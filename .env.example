# Copia este archivo a .env y completa los valores.
# El monitor funciona sin Telegram configurado (las alertas solo quedan en el log),
# así que puedes dejarlo vacío mientras pruebas.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: ajustar el ritmo de scraping
REQUEST_DELAY_SECONDS=2.5
CYCLE_INTERVAL_SECONDS=1800
