# Copia este archivo a .env y completa los valores.
# El monitor funciona sin Telegram configurado (las alertas solo quedan en el log),
# así que puedes dejarlo vacío mientras pruebas.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sitios activos en este ciclo (claves definidas en src/sites/__init__.py),
# separados por coma, sin espacios. Si falta esta línea, config.py usa
# "falabella" como único valor por defecto.
ACTIVE_SITES=falabella,ripley,paris,theline,marathon,sodimac,jumbo,hites,easy,santaisabel,abcdin,preunic,kitchencenter
# tricot: suspendido (sus categorías son solo ropa/zapatos, fuera del foco actual)

# Opcional: ajustar el ritmo de scraping
REQUEST_DELAY_SECONDS=2.5
CYCLE_INTERVAL_SECONDS=1800
